## ====================================================================
## ComicReader - Git Ignore Specification
## Target: C# .NET 8 WPF Desktop Application
## ====================================================================

# Build Outputs & Compilation Artifacts
[Bb]in/
[Oo]bj/
[Aa]rtifacts/
[Pp]ublish/
[Oo]ut/
*.baml
*.g.cs
*.g.i.cs

# Visual Studio & IDE Metadata
.vs/
*.user
*.userprefs
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains Rider
.idea/
*.sln.iml

# User Configuration & Local Data Overrides
usersettings.json
usersettings.*.json
reading_progress.json
reading_progress.*.json

# Local Runtime Caches & Temporary Extraction Buffers
.cache/
*.cache
*.tmp
*.temp

# Log Files & Diagnostic Dumps
*.log
crash*.log
startup_error*.log

# Windows OS Generated Files
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS Generated Files
.DS_Store
.AppleDouble
.LSOverride
__MACOSX/
._*

# NuGet & Package Management
*.nupkg
*.snupkg
packages/
*.nuget.props
*.nuget.targets
project.lock.json
project.assets.json

# Profiling & Diagnostics
*.prof
*.pid
*.pid.lock
