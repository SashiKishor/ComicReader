<UserControl x:Class="ComicReader.Views.ReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:ComicReader.ViewModels"
             xmlns:models="clr-namespace:ComicReader.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ReaderViewModel}"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             Background="#000000">

    <UserControl.Resources>
        <!-- Fit Mode Toggle Button Style -->
        <Style x:Key="FitModeRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="#2A2A2A"
                                BorderBrush="#3A3A3A"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="2,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation Edge Button Style -->
        <Style x:Key="EdgeTurnButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="edgeBorder"
                                Background="Transparent"
                                Opacity="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="edgeBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.85"
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="edgeBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Continuous Storyboard for Premium Sweeping & Breathing Loading Indicator -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <!-- Smooth 360-degree Sweeping Rotation of Outer Accent Ring -->
                    <DoubleAnimation Storyboard.TargetName="SweepingRingTransform"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360"
                                     Duration="0:0:1.6"/>
                    <!-- Smooth Breathing Pulsing of Inner Translucent Pod -->
                    <DoubleAnimation Storyboard.TargetName="BreathingPodScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.95" To="1.05"
                                     AutoReverse="True"
                                     Duration="0:0:0.9"/>
                    <DoubleAnimation Storyboard.TargetName="BreathingPodScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.95" To="1.05"
                                     AutoReverse="True"
                                     Duration="0:0:0.9"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid x:Name="RootReaderGrid" Background="#000000">

        <!-- LAYER 1: Full-Screen Interactive Viewport (Bottom Z-Index, Occupies Entire Window) -->
        <ScrollViewer x:Name="PageScrollViewer"
                      Background="#000000"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      PanningMode="Both"
                      Focusable="False"
                      PreviewMouseLeftButtonDown="PageScrollViewer_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="PageScrollViewer_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="PageScrollViewer_PreviewMouseLeftButtonUp"
                      PreviewMouseWheel="PageScrollViewer_PreviewMouseWheel"
                      LostMouseCapture="PageScrollViewer_LostMouseCapture"
                      ScrollChanged="PageScrollViewer_ScrollChanged">
            <Grid Background="#000000" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Page Container with Smooth Sliding & Opacity Fade Animations -->
                <Border x:Name="PageContentHost"
                        Background="#000000"
                        Opacity="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <!-- LayoutTransform: Scales layout bounds for multi-axis scrolling when zoomed in -->
                    <Border.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"/>
                    </Border.LayoutTransform>
                    <!-- RenderTransform: Decoupled for pure page turn transition slides -->
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PageSlideTransform" X="0" Y="0"/>
                    </Border.RenderTransform>

                    <Image x:Name="ComicImageElement"
                           Source="{Binding CurrentPageImage}"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Stretch" Value="Uniform"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FitMode}" Value="{x:Static models:PageFitMode.FitToScreen}">
                                        <Setter Property="Stretch" Value="Uniform"/>
                                        <Setter Property="MaxHeight" Value="{Binding ActualHeight, ElementName=PageScrollViewer}"/>
                                        <Setter Property="MaxWidth" Value="{Binding ActualWidth, ElementName=PageScrollViewer}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FitMode}" Value="{x:Static models:PageFitMode.FitToWidth}">
                                        <Setter Property="Stretch" Value="Uniform"/>
                                        <Setter Property="Width" Value="{Binding ActualWidth, ElementName=PageScrollViewer}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FitMode}" Value="{x:Static models:PageFitMode.FitToHeight}">
                                        <Setter Property="Stretch" Value="Uniform"/>
                                        <Setter Property="Height" Value="{Binding ActualHeight, ElementName=PageScrollViewer}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FitMode}" Value="{x:Static models:PageFitMode.OriginalSize}">
                                        <Setter Property="Stretch" Value="None"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- LAYER 2: Left & Right Click-to-Turn Edge Buttons (Vertically Centered) -->
        <Button HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Width="100"
                Height="220"
                Style="{StaticResource EdgeTurnButtonStyle}"
                Command="{Binding PreviousPageCommand}"
                IsEnabled="{Binding CanGoPrevious}"
                ToolTip="Previous Page (Left Arrow / Click)">
            <Border Background="#66000000"
                    CornerRadius="0,24,24,0"
                    Padding="16,24"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <TextBlock Text="◀" Foreground="White" FontSize="26" FontWeight="Bold"/>
            </Border>
        </Button>

        <Button HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="100"
                Height="220"
                Style="{StaticResource EdgeTurnButtonStyle}"
                Command="{Binding NextPageCommand}"
                IsEnabled="{Binding CanGoNext}"
                ToolTip="Next Page (Right Arrow / Space / Click)">
            <Border Background="#66000000"
                    CornerRadius="24,0,0,24"
                    Padding="16,24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                <TextBlock Text="▶" Foreground="White" FontSize="26" FontWeight="Bold"/>
            </Border>
        </Button>

        <!-- LAYER 3: Top Auto-Hide Trigger Zone & Floating Header Bar -->
        <Grid x:Name="TopHoverZone"
              VerticalAlignment="Top"
              HorizontalAlignment="Stretch"
              Background="Transparent"
              Height="60">

            <!-- Floating Top Header Panel (Opacity 0 by default, smoothly fades in on hover) -->
            <Border x:Name="TopHeaderPanel"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Background="#E6141414"
                    BorderBrush="#2B2B2B"
                    BorderThickness="0,0,0,1"
                    Padding="18,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0.0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Grid}}, Path=IsMouseOver}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="1.0"
                                                             Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="0.0"
                                                             Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Back to Library Button -->
                    <Button Command="{Binding CloseReaderCommand}"
                            Style="{StaticResource NetflixSecondaryButton}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←" FontWeight="Bold" Margin="0,0,6,0"/>
                            <TextBlock Text="Back to Library"/>
                        </StackPanel>
                    </Button>

                    <!-- Comic Title -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="15"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               MaxWidth="600"/>

                    <!-- Display Mode & Zoom Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Fit Screen Toggle -->
                        <RadioButton Content="Fit Screen"
                                     Style="{StaticResource FitModeRadioStyle}"
                                     IsChecked="{Binding FitMode, Converter={StaticResource FitModeToBoolConverter}, ConverterParameter=FitToScreen}"
                                     Command="{Binding SetFitModeCommand}"
                                     CommandParameter="{x:Static models:PageFitMode.FitToScreen}"/>

                        <!-- Fit Width Toggle -->
                        <RadioButton Content="Fit Width"
                                     Style="{StaticResource FitModeRadioStyle}"
                                     IsChecked="{Binding FitMode, Converter={StaticResource FitModeToBoolConverter}, ConverterParameter=FitToWidth}"
                                     Command="{Binding SetFitModeCommand}"
                                     CommandParameter="{x:Static models:PageFitMode.FitToWidth}"/>

                        <!-- Fit Height Toggle -->
                        <RadioButton Content="Fit Height"
                                     Style="{StaticResource FitModeRadioStyle}"
                                     IsChecked="{Binding FitMode, Converter={StaticResource FitModeToBoolConverter}, ConverterParameter=FitToHeight}"
                                     Command="{Binding SetFitModeCommand}"
                                     CommandParameter="{x:Static models:PageFitMode.FitToHeight}"/>

                        <!-- Zoom Controls -->
                        <Border Background="#222222" CornerRadius="4" Margin="8,0,0,0" Padding="4,2">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="-" Command="{Binding ZoomOutCommand}" Style="{StaticResource NetflixSecondaryButton}" Padding="8,2" Margin="2,0"/>
                                <TextBlock Text="{Binding ZoomFactor, StringFormat='{}{0:P0}'}" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="6,0" FontSize="11"/>
                                <Button Content="+" Command="{Binding ZoomInCommand}" Style="{StaticResource NetflixSecondaryButton}" Padding="8,2" Margin="2,0"/>
                                <Button Content="1:1" Command="{Binding ResetZoomCommand}" Style="{StaticResource NetflixSecondaryButton}" Padding="6,2" Margin="2,0" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <!-- Settings Button -->
                        <Button Command="{Binding OpenSettingsCommand}"
                                Style="{StaticResource NetflixSecondaryButton}"
                                Margin="8,0,0,0"
                                Padding="8,4"
                                ToolTip="Reader Settings">
                            <TextBlock Text="⚙" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- LAYER 4: Bottom Auto-Hide Trigger Zone & Floating Scrubber Bar -->
        <Grid x:Name="BottomHoverZone"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Stretch"
              Background="Transparent"
              Height="90">

            <!-- Floating Bottom Page Turn Scrubber Bar (Opacity 0 by default, smoothly fades in on hover) -->
            <Border x:Name="BottomFooterPanel"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Background="#E6181818"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="24"
                    Margin="0,0,0,20"
                    Padding="20,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0.0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Grid}}, Path=IsMouseOver}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="1.0"
                                                             Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="0.0"
                                                             Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Previous Button -->
                    <Button Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding CanGoPrevious}"
                            Style="{StaticResource NetflixSecondaryButton}"
                            Padding="12,5"
                            Margin="0,0,12,0">
                        <TextBlock Text="◀ Prev"/>
                    </Button>

                    <!-- Page Scrubber Slider (1-based to TotalPages, loads on DragCompleted) -->
                    <Slider x:Name="PageSlider"
                            Minimum="1"
                            Maximum="{Binding MaxPageNumber}"
                            Value="{Binding ScrubberPageNumber, Mode=TwoWay}"
                            SmallChange="1"
                            LargeChange="5"
                            Width="280"
                            VerticalAlignment="Center"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            Margin="8,0"
                            Thumb.DragCompleted="PageSlider_DragCompleted"
                            PreviewMouseLeftButtonUp="PageSlider_PreviewMouseLeftButtonUp"
                            PreviewKeyUp="PageSlider_PreviewKeyUp"/>

                    <!-- Page Counter Badge -->
                    <Border Background="#2B2B2B" CornerRadius="12" Padding="12,4" Margin="12,0">
                        <TextBlock Text="{Binding PageCounterText}"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontWeight="Bold"
                                   FontSize="12"/>
                    </Border>

                    <!-- Next Button -->
                    <Button Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding CanGoNext}"
                            Style="{StaticResource NetflixActionButton}"
                            Padding="12,5">
                        <TextBlock Text="Next ▶"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- LAYER 5: Upgraded Premium Cinematic Loading Overlay (Z-Index 100) -->
        <Grid x:Name="CinematicLoadingOverlay"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Panel.ZIndex="100"
              Visibility="Collapsed"
              Opacity="1">

            <!-- Layer 1: Frosted Glass / Gaussian Blur Background Cover Art -->
            <Image Source="{Binding CoverImageSource}"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
                <Image.Effect>
                    <BlurEffect Radius="50" KernelType="Gaussian"/>
                </Image.Effect>
            </Image>

            <!-- Layer 2: Deep Dark Tint Overlay -->
            <Border Background="#E0050505" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Layer 3: Modern Breathing Pod & Sweeping Glow Indicator -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Outer Minimalist Sweeping Accent Ring -->
                <Ellipse Width="180" Height="180"
                         StrokeThickness="3.5"
                         StrokeDashArray="8,2"
                         Opacity="0.92"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E50914" Offset="0"/>
                            <GradientStop Color="#FF3B30" Offset="0.5"/>
                            <GradientStop Color="#22E50914" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SweepingRingTransform" Angle="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Inner Pulsing Breathing Pod with Drop Shadow -->
                <Border x:Name="BreathingPod"
                        Width="152"
                        Height="152"
                        CornerRadius="76"
                        Background="#66141414"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1.5"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.Effect>
                        <DropShadowEffect Color="#E50914" BlurRadius="28" Opacity="0.35" ShadowDepth="0"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="BreathingPodScale" ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                        <TextBlock Text="📖"
                                   FontSize="26"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="LOADING"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LoadingProgressText}"
                                   Foreground="#CCCCCC"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="130"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- LAYER 6: Settings Dialog Modal Overlay -->
        <Grid Background="#B3000000"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisConverter}}"
              Panel.ZIndex="200">
            <!-- Settings Card -->
            <Border Width="540"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#1E1E1E"
                    BorderBrush="#383838"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="18" Foreground="{StaticResource BrushAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="READER SETTINGS" FontSize="18" FontWeight="Black" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Command="{Binding CloseSettingsCommand}"
                                Style="{StaticResource NetflixSecondaryButton}"
                                Padding="8,4"
                                Width="32" Height="32"
                                ToolTip="Close Settings">
                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <!-- Setting: Default Fit Mode -->
                    <Border Background="#252525"
                            BorderBrush="#333333"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,14"
                            Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Default Page Fit Mode"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Automatically scale pages when opening comics. Changing this applies instantly to the current comic."
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableFitModes}"
                                      SelectedItem="{Binding DefaultFitMode, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Height="36"
                                      Cursor="Hand">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"
                                                   Foreground="White"
                                                   FontSize="12"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Setting 2: Default Zoom Level -->
                    <Border Background="#252525"
                            BorderBrush="#333333"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,14"
                            Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Default Zoom Level"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Initial magnification applied to comic pages upon opening. Changing this applies instantly."
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableZoomLevels}"
                                      SelectedItem="{Binding DefaultZoomFactor, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Height="36"
                                      Cursor="Hand">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource ZoomLevelToStringConverter}}"
                                                   Foreground="White"
                                                   FontSize="12"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Footer Actions -->
                    <Button Command="{Binding CloseSettingsCommand}"
                            Style="{StaticResource NetflixActionButton}"
                            HorizontalAlignment="Right"
                            Padding="26,8"
                            Content="Done"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
