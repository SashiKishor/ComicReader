<UserControl x:Class="ComicReader.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:ComicReader.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
             Background="{StaticResource BrushBgPrimary}">

    <UserControl.Resources>
        <!-- DataTemplate for Navigable Subfolders -->
        <DataTemplate DataType="{x:Type vm:FolderItemViewModel}">
            <Button Command="{Binding DataContext.OpenNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Margin="15"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Width="180"
                                Height="280"
                                Background="{StaticResource BrushBgCard}"
                                BorderBrush="#2F3640"
                                BorderThickness="1"
                                CornerRadius="6"
                                ClipToBounds="True">
                            <Grid>
                                <!-- 1. Folder Cover Art (if detected by peeking inside) -->
                                <Image Source="{Binding CoverPath}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding CoverPath, Converter={StaticResource NullToVisConverter}}"/>

                                <!-- 2. Folder Placeholder when no cover art is found or loading -->
                                <Grid Background="#1A202C"
                                      Visibility="{Binding CoverPath, Converter={StaticResource NullToVisConverter}, ConverterParameter=Inverse}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📁" 
                                                   FontSize="48" 
                                                   HorizontalAlignment="Center"
                                                   Opacity="0.85"/>
                                        <TextBlock Text="FOLDER" 
                                                   Foreground="#94A3B8"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Scanning..." 
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="10"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Center"
                                                   Visibility="{Binding IsLoadingCover, Converter={StaticResource BoolToVisConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 3. Visual Distinction: Blue Folder Badge (Top-Left) -->
                                <Border HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="8"
                                        Background="#2563EB"
                                        CornerRadius="3"
                                        Padding="6,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁 " FontSize="9"/>
                                        <TextBlock Text="{Binding BadgeText}"
                                                   Foreground="White"
                                                   FontSize="9"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- 4. Title & Item Count Overlay (Bottom) -->
                                <Border VerticalAlignment="Bottom"
                                        Padding="10,8,10,12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#CC000000" Offset="0.35"/>
                                            <GradientStop Color="#F0000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="32"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Foreground="#60A5FA"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Folder Hover Transition -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="#2D3748"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- DataTemplate for Comic/Document Files -->
        <DataTemplate DataType="{x:Type vm:ComicItemViewModel}">
            <Button Command="{Binding DataContext.OpenNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Margin="15"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Width="180"
                                Height="280"
                                Background="{StaticResource BrushBgCard}"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                CornerRadius="6"
                                ClipToBounds="True">
                            <Grid>
                                <!-- 1. Comic Cover Art Poster -->
                                <Image Source="{Binding CoverPath}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding CoverPath, Converter={StaticResource NullToVisConverter}}"/>

                                <!-- 2. Placeholder When Cover is Missing / Loading -->
                                <Grid Background="#1E1E1E"
                                      Visibility="{Binding CoverPath, Converter={StaticResource NullToVisConverter}, ConverterParameter=Inverse}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📖" 
                                                   FontSize="36" 
                                                   HorizontalAlignment="Center"
                                                   Opacity="0.6"/>
                                        <TextBlock Text="Loading..." 
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="11"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center"
                                                   Visibility="{Binding IsLoadingCover, Converter={StaticResource BoolToVisConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 3. Visual Distinction: Red File Format Badge (Top-Right) -->
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="8"
                                        Background="{StaticResource BrushAccent}"
                                        CornerRadius="3"
                                        Padding="6,3">
                                    <TextBlock Text="{Binding BadgeText}"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>
                                </Border>

                                <!-- 4. Title & File Size Overlay (Bottom) -->
                                <Border VerticalAlignment="Bottom"
                                        Padding="10,8,10,12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#CC000000" Offset="0.35"/>
                                            <GradientStop Color="#F0000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="32"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="10"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 5. Slim Netflix-Style Red Progress Bar (Bottom Flush Edge) -->
                                <ProgressBar Style="{StaticResource NetflixProgressBarStyle}"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding ProgressPercentage, Mode=OneWay}"
                                             VerticalAlignment="Bottom"
                                             Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisConverter}}"/>
                            </Grid>
                        </Border>

                        <!-- Comic Card Hover Transition -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="#2E2E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation & Action Bar -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgSecondary}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Back Button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="COMIC" 
                               Foreground="{StaticResource BrushAccent}" 
                               FontWeight="Black" 
                               FontSize="22"/>
                    <TextBlock Text="READER" 
                               Foreground="{StaticResource BrushTextPrimary}" 
                               FontWeight="Bold" 
                               FontSize="22"
                               Margin="2,0,0,0"/>
                    <Border Background="#2B2B2B" 
                            CornerRadius="3" 
                            Margin="12,0,0,0" 
                            Padding="6,2" 
                            VerticalAlignment="Center">
                        <TextBlock Text="LIBRARY" 
                                   Foreground="{StaticResource BrushTextSecondary}" 
                                   FontSize="10" 
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Current Folder Path Display -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            Margin="28,0,16,0">
                    <TextBlock Text="LOCATION:" 
                               Foreground="{StaticResource BrushTextSecondary}" 
                               FontSize="11" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0"/>
                    <Border Background="#232323" 
                            BorderBrush="#383838" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="8,4" 
                            MaxWidth="520"
                            ToolTip="{Binding CurrentDirectory}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 " FontSize="11"/>
                            <TextBlock Text="{Binding CurrentDirectory}" 
                                       Foreground="{StaticResource BrushTextPrimary}" 
                                       FontSize="12" 
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Action Controls (Back, Change Folder & Rescan) -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center">

                    <!-- Up / Back Button -->
                    <Button Command="{Binding NavigateUpCommand}"
                            Style="{StaticResource NetflixSecondaryButton}"
                            Visibility="{Binding CanNavigateUp, Converter={StaticResource BoolToVisConverter}}"
                            Margin="0,0,10,0"
                            ToolTip="Back to Parent Folder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬅" Margin="0,0,6,0" FontWeight="Bold"/>
                            <TextBlock Text="Back" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ChangeFolderCommand}"
                            Style="{StaticResource NetflixSecondaryButton}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" Margin="0,0,6,0"/>
                            <TextBlock Text="Change Folder"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource NetflixActionButton}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" Margin="0,0,6,0" FontWeight="Bold"/>
                            <TextBlock Text="Rescan"/>
                        </StackPanel>
                    </Button>

                    <!-- Settings Button -->
                    <Button Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource NetflixSecondaryButton}"
                            Margin="10,0,0,0"
                            ToolTip="Application &amp; Reader Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Margin="0,0,6,0"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area: Hierarchical Grid -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="28,20,28,32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Current Folder Breadcrumb & Item Count Header -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Clickable Quick Back Icon if inside subfolder -->
                        <Button Command="{Binding NavigateUpCommand}"
                                Visibility="{Binding CanNavigateUp, Converter={StaticResource BoolToVisConverter}}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#60A5FA"
                                Cursor="Hand"
                                Margin="0,0,10,0"
                                ToolTip="Go up to parent folder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬅ " FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Parent Folder  |" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="📁 " FontSize="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding CurrentFolderName}"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <Border Background="#2B2B2B"
                                CornerRadius="10"
                                Margin="12,0,0,0"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalItemsCount, StringFormat='{}{0} items'}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Unified Polymorphic Grid (Displays Folders & Comics Side-By-Side) -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Left" Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Empty State (Folder has 0 items) -->
                <Border Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="520"
                        Background="{StaticResource BrushBgSecondary}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="36,40"
                        Margin="0,60"
                        Visibility="{Binding HasNoItemsFound, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📂" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Text="This Folder is Empty" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="We didn't find any supported comic files (.cbr, .cbz, .pdf) or subfolders here."
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,10,0,22"
                                   LineHeight="20"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Command="{Binding NavigateUpCommand}"
                                    Style="{StaticResource NetflixActionButton}"
                                    Visibility="{Binding CanNavigateUp, Converter={StaticResource BoolToVisConverter}}"
                                    Margin="0,0,12,0"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⬅" Margin="0,0,8,0"/>
                                    <TextBlock Text="Go Up One Level"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ChangeFolderCommand}"
                                    Style="{StaticResource NetflixSecondaryButton}"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" Margin="0,0,8,0"/>
                                    <TextBlock Text="Change Library Folder"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2"
                Background="#0D0D0D"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="{Binding IsScanning}"
                                 Width="70"
                                 Height="3"
                                 Foreground="{StaticResource BrushAccent}"
                                 Background="#333333"
                                 BorderThickness="0"
                                 Margin="0,0,12,0"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}"/>
                    <TextBlock Text="{Binding StatusMessage}" 
                               Foreground="{StaticResource BrushTextSecondary}" 
                               FontSize="12"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding TotalItemsCount, StringFormat='{}{0} Items'}"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="12"
                           FontWeight="SemiBold"/>
            </Grid>
        </Border>
        <!-- Modal Overlay: Settings Dialog -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#B3000000"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisConverter}}"
              Panel.ZIndex="100">

            <!-- Settings Dialog Window Card -->
            <Border Width="560"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#1E1E1E"
                    BorderBrush="#383838"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <StackPanel>
                    <!-- Dialog Header -->
                    <Grid Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="18" Foreground="{StaticResource BrushAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SETTINGS" FontSize="18" FontWeight="Black" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Command="{Binding CloseSettingsCommand}"
                                Style="{StaticResource NetflixSecondaryButton}"
                                Padding="8,4"
                                Width="32" Height="32"
                                ToolTip="Close Settings">
                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <!-- Section: Reading Experience -->
                    <TextBlock Text="READING EXPERIENCE"
                               Foreground="{StaticResource BrushAccent}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <!-- Setting 1: Default Fit Mode -->
                    <Border Background="#252525"
                            BorderBrush="#333333"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,14"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Default Page Fit Mode"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Choose how comic pages scale automatically when opened in the reader."
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableFitModes}"
                                      SelectedItem="{Binding DefaultFitMode, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Height="36"
                                      Cursor="Hand">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"
                                                   Foreground="White"
                                                   FontSize="12"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Setting 2: Default Zoom Level -->
                    <Border Background="#252525"
                            BorderBrush="#333333"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,14"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Default Zoom Level"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Initial magnification applied to comic pages upon opening."
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableZoomLevels}"
                                      SelectedItem="{Binding DefaultZoomFactor, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Height="36"
                                      Cursor="Hand">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource ZoomLevelToStringConverter}}"
                                                   Foreground="White"
                                                   FontSize="12"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Section: Library Folder -->
                    <TextBlock Text="LIBRARY FOLDER"
                               Foreground="{StaticResource BrushAccent}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,8,0,12"/>

                    <Border Background="#252525"
                            BorderBrush="#333333"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,14"
                            Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Root Directory"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding RootDirectory}"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding ChangeFolderCommand}"
                                    Style="{StaticResource NetflixSecondaryButton}"
                                    VerticalAlignment="Center"
                                    Padding="14,6"
                                    Content="Change..."/>
                        </Grid>
                    </Border>

                    <!-- Footer Actions -->
                    <Button Command="{Binding CloseSettingsCommand}"
                            Style="{StaticResource NetflixActionButton}"
                            HorizontalAlignment="Right"
                            Padding="26,8"
                            Content="Done"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
