<UserControl x:Class="ComicReader.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:ComicReader.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:StartupViewModel}"
             Background="{StaticResource BrushBgPrimary}">

    <!-- Centered Onboarding Card Grid -->
    <Grid>
        <Border Width="560" 
                Background="{StaticResource BrushBgSecondary}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="44,48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            
            <StackPanel HorizontalAlignment="Center">
                <!-- ComicReader Brand Logo -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="COMIC" 
                               Foreground="{StaticResource BrushAccent}" 
                               FontWeight="Black" 
                               FontSize="36"/>
                    <TextBlock Text="READER" 
                               Foreground="{StaticResource BrushTextPrimary}" 
                               FontWeight="Bold" 
                               FontSize="36" 
                               Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Subtitle / Welcome Title -->
                <TextBlock Text="{Binding WelcomeTitle}" 
                           Foreground="{StaticResource BrushTextPrimary}" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <!-- Explanatory Instructions -->
                <TextBlock Text="{Binding InstructionText}" 
                           Foreground="{StaticResource BrushTextSecondary}" 
                           FontSize="13" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"
                           LineHeight="20"
                           Margin="0,0,0,32"/>

                <!-- One-Time Setup Hint -->
                <Border Background="#202020" 
                        CornerRadius="4" 
                        Padding="14,10" 
                        Margin="0,0,0,26">
                    <TextBlock Text="⚡ You only need to do this once. ComicReader permanently saves your choice and will automatically open this folder on all future launches." 
                               Foreground="#888888" 
                               FontSize="11" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center"/>
                </Border>

                <!-- Selection Button (Red Button) -->
                <Button Command="{Binding SelectFolderCommand}"
                        Style="{StaticResource NetflixActionButton}"
                        HorizontalAlignment="Center"
                        Padding="28,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" Margin="0,0,10,0" FontSize="15"/>
                        <TextBlock Text="Select Comic Folder" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Error Message Display -->
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#FF4444" 
                           FontSize="12" 
                           HorizontalAlignment="Center" 
                           Margin="0,16,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
