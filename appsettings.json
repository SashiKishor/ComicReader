{
  "Library": {
    "SupportedExtensions": [
      ".cbr",
      ".cbz",
      ".pdf"
    ],
    "DefaultLibraryPath": "",
    "MaxDegreeOfParallelism": 4,
    "ThumbnailQuality": 85,
    "ThumbnailMaxWidth": 360,
    "ThumbnailMaxHeight": 540
  },
  "Cache": {
    "CacheDirectory": ".cache\\covers",
    "MaxCacheSizeMegaBytes": 1024,
    "EnableDiskCache": true
  },
  "Reader": {
    "PageAnimationDurationMs": 250,
    "DefaultFitMode": "FitToScreen",
    "DefaultZoomFactor": 1.0,
    "SmoothScrolling": true,
    "PreloadPageCount": 2
  },
  "Theme": {
    "PrimaryBackground": "#141414",
    "SecondaryBackground": "#181818",
    "CardBackground": "#232323",
    "AccentColor": "#E50914",
    "AccentHoverColor": "#F40612",
    "TextPrimary": "#FFFFFF",
    "TextSecondary": "#AAAAAA",
    "SurfaceBorder": "#333333"
  }
}
